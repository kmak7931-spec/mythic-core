    mythic:zodiac "5th House (Leo)" .

mythic:S_Zodiac a owl:NamedIndividual ;
    mythic:corresponds_to mythic:Vertex_S ;
    mythic:zodiac "1st House (Aries)" .

mythic:T_Zodiac a owl:NamedIndividual ;
    mythic:corresponds_to mythic:Vertex_T ;
