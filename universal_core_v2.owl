mythic:Theta_Zodiac a owl:NamedIndividual ;
    mythic:corresponds_to mythic:Vertex_Theta ;
    mythic:zodiac "12th House (Pisces)" .

mythic:UnanimousTwelveRule a mythic:ConsensusRule,
        owl:NamedIndividual ;
    rdfs:label "12-of-12 unanimous passage rule" ;
    mythic:centerVotes false ;
    mythic:requiredVotes 12 ;
    mythic:silenceIsConsent false ;
    mythic:totalVoters 12 .

mythic:activationInstruction a owl:DatatypeProperty .

